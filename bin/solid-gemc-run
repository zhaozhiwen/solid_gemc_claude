#!/usr/bin/env bash
# solid-gemc-run — the only bridge between solid-gemc-claude and the SoLID/GEMC
# runtime. Every solid_gemc, scons, ROOT, or xmllint invocation in commands
# and skills must pass through here. The container .sif URL, solid_gemc
# upstream, and GEMC_VERSION are pinned in this file alone.

set -euo pipefail

# --- pinned runtime (single source of truth) ---------------------------------

# JLabCE 2.5 container. Hosted at Zhiwen Zhao's Duke physics webhome at v0.0.1
# (see README "Known limitations" — personal hosting, no SLA, mirror locally
# if you need durability). The sha256 in the filename is the docker image
# manifest digest of jeffersonlab/jlabce:2.5; that is *not* the .sif file's
# own content hash, so no automated checksum verification at v0.0.1.
SIF_NAME="jeffersonlab_jlabce_tag2.5_digest:sha256:9b9a9ec8c793035d5bfe6651150b54ac298f5ad17dca490a8039c530d0302008_20220413_s3.9.5.sif"
SIF_URL="http://webhome.phy.duke.edu/~zz81/simg/${SIF_NAME}"

# solid_gemc source. v0.0.1 clones HEAD of master (no upstream pin); the
# resolved commit SHA is recorded per run in runs/<id>/config.json.
SOLID_GEMC_REPO="https://github.com/JeffersonLab/solid_gemc"

# Version directory used inside solid_gemc's layout: mod/gemc/<v>, source/<v>.
# Bump only when solid_gemc upstream supports a new GEMC version line.
GEMC_VERSION="2.9"

# --- paths -------------------------------------------------------------------
PLUGIN_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# --- helpers -----------------------------------------------------------------
log()  { printf '[solid-gemc-run] %s\n' "$*" >&2; }
die()  { printf '[solid-gemc-run] error: %s\n' "$*" >&2; exit 1; }

# True when this script runs from a Codex CLI plugin install
# ($CODEX_HOME/plugins/cache/<marketplace>/<plugin>/<version>/). Codex exposes no
# env var like CLAUDE_PLUGIN_DATA, so PLUGIN_ROOT is the ground-truth signal.
# CODEX_HOME defaults to ~/.codex but is configurable (e.g. a project-local
# `codex_home/`), so the literal `.codex/plugins` is NOT reliable — key off the
# stable structural marker every Codex install shares, a `/plugins/cache/` path
# segment, and prefer an explicit CODEX_HOME match when the harness exports it.
# A bare git clone is under neither and keeps the XDG fallback. (A Claude install
# path also contains `/plugins/cache/`, but that's moot: the CLAUDE_PLUGIN_DATA
# tier is resolved before this function is ever consulted.)
is_codex_install() {
  [[ -n "${CODEX_HOME:-}" && "${PLUGIN_ROOT}/" == "${CODEX_HOME%/}/"* ]] && return 0
  [[ "${PLUGIN_ROOT}" == *"/plugins/cache/"* ]]
}

# Cache resolution (four tiers, in order):
#   1. $SOLID_GEMC_CLAUDE_CACHE        explicit override (any platform)
#   2. $CLAUDE_PLUGIN_DATA/cache       Claude Code plugin data dir
#   3. ${PLUGIN_ROOT}/cache            Codex plugin install ($CODEX_HOME/plugins/cache)
#   4. ${XDG_CACHE_HOME:-~/.cache}/solid-gemc-claude   bare shell / standalone
# Tiers 2 and 3 co-locate the .sif with the plugin install so each harness
# manages its own copy and the big artifact is never orphaned in ~/.cache. The
# XDG tier is the last resort for a bare git clone. When CLAUDE_PLUGIN_DATA *is*
# set we stay strictly inside it (no $HOME fallback), so the plugin's own .sif
# is never shadowed by a phantom re-download. See CLAUDE.md non-negotiable #7.
# Resolution is lazy so `solid-gemc-run help` works without any env vars set.
CACHE_DIR=""
SIF_DIR=""
SIF_PATH=""
resolve_cache_dir() {
  [[ -n "${CACHE_DIR}" ]] && return 0
  if [[ -n "${SOLID_GEMC_CLAUDE_CACHE:-}" ]]; then
    CACHE_DIR="${SOLID_GEMC_CLAUDE_CACHE}"
  elif [[ -n "${CLAUDE_PLUGIN_DATA:-}" ]]; then
    CACHE_DIR="${CLAUDE_PLUGIN_DATA}/cache"
  elif is_codex_install; then
    CACHE_DIR="${PLUGIN_ROOT}/cache"
  else
    CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/solid-gemc-claude"
  fi
  SIF_DIR="${CACHE_DIR}/sif"
  SIF_PATH="${SIF_DIR}/${SIF_NAME}"
}

# Data dir (venv home) resolution, mirroring the cache tiers:
#   1. $CLAUDE_PLUGIN_DATA              Claude Code plugin data dir
#   2. ${PLUGIN_ROOT}                   Codex plugin install ($CODEX_HOME/plugins/cache)
#   3. ${XDG_DATA_HOME:-~/.local/share}/solid-gemc-claude   bare shell / standalone
# The venv is installed lazily on first use (see ensure_venv_python below) on
# every platform — no session hook. Run `setup-python` to pre-install it.
DATA_DIR=""
VENV_DIR=""
resolve_data_dir() {
  [[ -n "${DATA_DIR}" ]] && return 0
  if [[ -n "${CLAUDE_PLUGIN_DATA:-}" ]]; then
    DATA_DIR="${CLAUDE_PLUGIN_DATA}"
  elif is_codex_install; then
    DATA_DIR="${PLUGIN_ROOT}"
  else
    DATA_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/solid-gemc-claude"
  fi
  VENV_DIR="${DATA_DIR}/venv"
}

require_apptainer() {
  command -v apptainer >/dev/null 2>&1 \
    || die "apptainer not found on PATH. Install apptainer first (https://apptainer.org)."
}

require_wget() {
  command -v wget >/dev/null 2>&1 || die "wget not found on PATH."
}

require_git() {
  command -v git >/dev/null 2>&1 || die "git not found on PATH."
}

ensure_sif() {
  resolve_cache_dir
  require_apptainer
  if [[ -f "${SIF_PATH}" ]]; then return 0; fi
  require_wget
  mkdir -p "${SIF_DIR}"
  log "downloading ${SIF_URL}"
  log "  -> ${SIF_PATH}"
  log "  (~1.7 GB .sif; first pull can take several minutes)"
  # Fixed .part path + -c so an interrupted pull resumes on re-run instead
  # of restarting from zero. The .sif host has no SLA (personal webhome),
  # so a dropped connection on the ~1.7 GB transfer is expected. The
  # partial is deliberately NOT deleted on failure — re-running `pull`
  # continues it.
  local tmp="${SIF_PATH}.part"
  if ! wget --show-progress -c -O "${tmp}" "${SIF_URL}"; then
    die "wget failed for ${SIF_URL} (partial kept at ${tmp}; re-run 'pull' to resume)"
  fi
  mv "${tmp}" "${SIF_PATH}"
  log "image ready at ${SIF_PATH}"
}

# Resolve symlinks before handing paths to apptainer. On shared-FS hosts the
# user's $HOME or $(pwd) can be a symlink chain (e.g. ~/work -> /work/...);
# apptainer will --bind the symlink path but then fail to chdir into it.
# `pwd -P` and `readlink -f` give the physical path apptainer can mount.
container_workdir()   { pwd -P; }
container_cache_dir() { readlink -f "${CACHE_DIR}"; }

# Tcsh env block for solid_gemc/GEMC inside the container. Honors any
# externally-set `$SoLID_GEMC` (lets slash commands cd into a subdir like
# `solid_gemc/analysis/hgc_study/` to pick up cwd-relative detector loading
# while keeping `SoLID_GEMC` pinned to the workspace root). Falls back to
# `${PWD}/solid_gemc` for the workspace-root-cwd case. The heredoc is
# single-quoted so `${VAR}` stays literal — tcsh interpolates at run time.
env_block() {
  cat <<'TCSH'
if ( ! $?SoLID_GEMC ) setenv SoLID_GEMC ${PWD}/solid_gemc
if ( ! $?LD_LIBRARY_PATH ) setenv LD_LIBRARY_PATH ""
setenv GEMC_VERSION 2.9
setenv GEMC ${SoLID_GEMC}/mod/gemc/${GEMC_VERSION}
setenv LD_LIBRARY_PATH ${GEMC}:${LD_LIBRARY_PATH}
setenv PATH ${SoLID_GEMC}/source/${GEMC_VERSION}:${GEMC}:${PATH}
TCSH
}

path_is_under() {
  local p="$1" dir="$2"
  [[ "$p" == "$dir" || "$p" == "$dir"/* ]]
}

# Echo host paths needing an explicit --bind beyond the workspace and cache.
# A path is auto-covered only if it is the bound workdir/cache or strictly
# inside one — an exact-prefix test, not a glob, so /work/ab does not swallow
# /work/abc. That distinction is load-bearing now that this feeds the core
# run path (the workspace root is a real bind, not a no-op).
extra_binds_for() {
  local wd="$1" cache_real="$2"; shift 2
  local p
  for p in "$@"; do
    [[ -z "$p" ]] && continue
    if ! path_is_under "$p" "$wd" && ! path_is_under "$p" "$cache_real"; then
      printf -- '--bind\n%s\n' "$p"
    fi
  done
}

# The bind set for any container invocation: cwd, cache, and — when
# $SoLID_GEMC is set — both the resolved solid_gemc tree and its parent
# (the workspace root). The skill/smoke cd into a deep subdir
# (solid_gemc/script, …) for cwd-relative geometry lookup, then read/write
# absolute paths in solid_gemc/{source,mod}/ (binary + libgemc.so) and
# <project>/runs/<id>/ (GCard in, EVIO/ROOT out) — none under cwd. Binding
# only cwd+cache made the run path work solely by accident of apptainer's
# implicit $HOME/$TMPDIR mount covering the workspace, which breaks on hosts
# with `mount home = no` or a workspace on /scratch|/work (violates
# non-negotiable #4). Both binds are needed, not redundant: when solid_gemc
# is a symlink out of the workspace (SGC_REUSE_SOLID_GEMC, or a user-linked
# prebuilt tree) the build tree lives under the resolved target while the
# run dir is a sibling of the symlink — the parent of the *unresolved* path.
# extra_binds_for dedupes whatever is already under cwd/cache.
container_binds() {
  local wd="$1" cache_real="$2"
  printf -- '--bind\n%s\n--bind\n%s\n' "${wd}" "${cache_real}"
  [[ -n "${SoLID_GEMC:-}" && -d "${SoLID_GEMC}" ]] || return 0
  local solid_real parent_real
  solid_real="$(readlink -f "${SoLID_GEMC}")"
  parent_real="$(readlink -f "$(dirname "${SoLID_GEMC}")")"
  extra_binds_for "${wd}" "${cache_real}" "${solid_real}" "${parent_real}"
}

# Run a tcsh command inside the container with the env block applied and the
# current working directory plus the cache bind-mounted.
in_container() {
  local cmd="$1"
  local wd cache_real env
  wd="$(container_workdir)"
  # SOLID_GEMC_RUN_DRYRUN=1: print the resolved apptainer bind/pwd argv and
  # return without touching the .sif. A container-free seam for the bind
  # regression test in tests/clean-smoke.sh — short-circuits before
  # ensure_sif so it needs neither the 1.7 GB image nor a network pull.
  if [[ -n "${SOLID_GEMC_RUN_DRYRUN:-}" ]]; then
    resolve_cache_dir
    cache_real="$(container_cache_dir)"
    container_binds "${wd}" "${cache_real}"
    printf -- '--pwd\n%s\n' "${wd}"
    return 0
  fi
  ensure_sif
  cache_real="$(container_cache_dir)"
  env="$(env_block)"
  local -a binds=()
  while IFS= read -r line; do binds+=("${line}"); done < <(
    container_binds "${wd}" "${cache_real}")
  apptainer exec \
    "${binds[@]}" \
    --pwd "${wd}" \
    "${SIF_PATH}" \
    tcsh -c "${env}
${cmd}"
}

# --- python venv -------------------------------------------------------------

# Idempotently install requirements.txt into the resolved venv. Diffs the
# bundled requirements against a stored copy; no-op when in sync. Uses `uv`
# when available (fast), else python3 -m venv + pip. Invoked lazily by
# ensure_venv_python, or run by hand to pre-install. KEEP PY_MIN in sync with
# the "Python 3.9+" line in README/docs.
PY_MIN=3.9
cmd_setup_python() {
  resolve_data_dir
  local req="${PLUGIN_ROOT}/requirements.txt"
  local stored="${DATA_DIR}/requirements.txt"
  [[ -f "${req}" ]] || die "requirements.txt not found at ${req}"
  diff -q "${req}" "${stored}" >/dev/null 2>&1 && return 0

  mkdir -p "${DATA_DIR}"
  log "installing Python deps into ${VENV_DIR} (one-time, ~30s)..."
  if [[ ! -x "${VENV_DIR}/bin/python" ]]; then
    rm -rf "${VENV_DIR}"
    if command -v uv >/dev/null 2>&1; then
      uv venv "${VENV_DIR}" --python ">=${PY_MIN}" >/dev/null
    else
      if ! python3 - "${PY_MIN}" <<'PY'
import sys
need = tuple(int(x) for x in sys.argv[1].split('.'))
raise SystemExit(0 if sys.version_info[:2] >= need else 1)
PY
      then
        die "python3 is $(python3 -V 2>&1 | awk '{print $2}'); need >= ${PY_MIN} (see README Requirements). Install a newer python3, or install 'uv'."
      fi
      python3 -m venv "${VENV_DIR}"
    fi
  fi

  local py="${VENV_DIR}/bin/python"
  if command -v uv >/dev/null 2>&1; then
    uv pip install --python "${py}" -r "${req}" >/dev/null
  else
    "${py}" -m pip install --upgrade pip >/dev/null
    "${py}" -m pip install -r "${req}" >/dev/null
  fi
  cp "${req}" "${stored}"   # mark success only after install succeeds
  log "Python deps ready."
}

# Echo the venv python, installing the venv first if absent. This is the only
# venv-install trigger (no session hook), so `analyze` always self-heals.
ensure_venv_python() {
  resolve_data_dir
  [[ -x "${VENV_DIR}/bin/python" ]] || cmd_setup_python >&2
  printf '%s' "${VENV_DIR}/bin/python"
}

# --- subcommands -------------------------------------------------------------

cmd_info() {
  resolve_cache_dir
  local cache_src
  if [[ -n "${SOLID_GEMC_CLAUDE_CACHE:-}" ]]; then
    cache_src="SOLID_GEMC_CLAUDE_CACHE override"
  elif [[ -n "${CLAUDE_PLUGIN_DATA:-}" ]]; then
    cache_src="CLAUDE_PLUGIN_DATA (Claude Code plugin)"
  elif is_codex_install; then
    cache_src="Codex plugin install (\$CODEX_HOME/plugins/cache)"
  else
    cache_src="XDG/home fallback (bare shell / standalone)"
  fi
  echo "sif url:        ${SIF_URL}"
  echo "sif file:       ${SIF_PATH} $([[ -f ${SIF_PATH} ]] && echo '[present]' || echo '[not pulled]')"
  echo "cache:          ${CACHE_DIR}  [${cache_src}]"
  echo "plugin:         ${PLUGIN_ROOT}"
  echo "solid_gemc:     ${SOLID_GEMC_REPO} (HEAD of master)"
  echo "GEMC_VERSION:   ${GEMC_VERSION}"
  if command -v apptainer >/dev/null 2>&1; then
    echo "apptainer:      $(apptainer --version)"
  else
    echo "apptainer:      NOT FOUND"
  fi
}

cmd_pull() {
  ensure_sif
}

cmd_clone() {
  local dest="${1:-solid_gemc}"
  if [[ -d "${dest}/.git" ]]; then
    local existing_sha dirty=""
    existing_sha=$(cd "${dest}" && git rev-parse HEAD 2>/dev/null || echo unknown)
    if ! (cd "${dest}" && git diff --quiet HEAD 2>/dev/null); then
      dirty=" (uncommitted local changes)"
    fi
    log "warning: ${dest} already cloned at ${existing_sha}${dirty}"
    log "  using existing tree. To refresh upstream: rm -rf ${dest} && solid-gemc-run clone"
    return 0
  fi
  if [[ -e "${dest}" ]]; then
    die "${dest} exists but is not a git clone. Move it aside or remove first."
  fi
  require_git
  log "cloning ${SOLID_GEMC_REPO} -> ${dest}"
  git clone "${SOLID_GEMC_REPO}" "${dest}"
  log "cloned: $(cd "${dest}" && git rev-parse HEAD)"
}

cmd_build() {
  local dest="${1:-solid_gemc}"
  [[ -d "${dest}" ]] \
    || die "solid_gemc tree not found at ${dest}; run 'solid-gemc-run clone' first"
  local gemc_dir="${dest}/mod/gemc/${GEMC_VERSION}"
  local solid_dir="${dest}/source/${GEMC_VERSION}"
  [[ -d "${gemc_dir}"  ]] \
    || die "missing ${gemc_dir} — solid_gemc layout may have changed; bump GEMC_VERSION in bin/solid-gemc-run?"
  [[ -d "${solid_dir}" ]] \
    || die "missing ${solid_dir} — solid_gemc layout may have changed?"

  # LIBRARY=shared is REQUIRED — mod/gemc/2.9/SConstruct gates libgemc.so
  # behind it. Without LIBRARY=shared, scons builds only the per-module
  # .a static archives and never produces libgemc.so; the downstream
  # source/2.9 link then fails with `cannot find -lgemc`. source/2.9
  # doesn't need its own LIBRARY flag (the gate there is commented out).
  log "building GEMC library at ${gemc_dir}"
  in_container "cd ${gemc_dir} && scons OPT=1 LIBRARY=shared -j4"
  log "building solid_gemc at ${solid_dir}"
  in_container "cd ${solid_dir} && scons OPT=1 -j4"
  log "build complete: ${solid_dir}/solid_gemc"
}

cmd_env() {
  env_block
}

cmd_exec() {
  [[ $# -ge 1 ]] || die "usage: solid-gemc-run exec <command...>"
  in_container "$*"
}

cmd_shell() {
  ensure_sif
  local wd cache_real env
  wd="$(container_workdir)"
  cache_real="$(container_cache_dir)"
  env="$(env_block)"
  local -a binds=()
  while IFS= read -r line; do binds+=("${line}"); done < <(
    container_binds "${wd}" "${cache_real}")
  log "entering container ($(basename "${SIF_PATH}")). Type 'exit' to leave."
  apptainer exec \
    "${binds[@]}" \
    --pwd "${wd}" \
    "${SIF_PATH}" \
    tcsh -c "${env}
exec tcsh -i"
}

cmd_root() {
  in_container "root -l -b -q $*"
}

cmd_validate_gcard() {
  local gcard="${1:-}"
  [[ -n "${gcard}" ]] || die "usage: solid-gemc-run validate-gcard <file.gcard>"
  [[ -f "${gcard}"  ]] || die "GCard not found: ${gcard}"
  in_container "xmllint --noout '${gcard}'"
  log "GCard well-formed: ${gcard}"
}

# One-shot workspace bootstrap: scaffold the workspace-common files, pull the
# .sif, clone solid_gemc, build it. Non-interactive — the collision/overwrite
# prompt lives in the adapter layer (Claude command / skill). Per-file
# skip-unless-force keeps it idempotent; solid_gemc/ and project subdirs are
# never touched.
cmd_init() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1
  require_apptainer; require_git; require_wget

  local tdir="${PLUGIN_ROOT}/templates" f src dst
  for f in CLAUDE.md AGENTS.md .gitignore log.md result.md report.html; do
    src="${tdir}/${f}"; dst="./${f}"
    [[ -e "${src}" ]] || continue
    if [[ -e "${dst}" && ${force} -eq 0 ]]; then
      log "exists, skipping (use --force to overwrite): ${dst}"
      continue
    fi
    cp -L "${src}" "${dst}"   # -L derefs the AGENTS.md->CLAUDE.md symlink
    log "wrote ${dst}"
  done

  cmd_pull
  cmd_clone
  cmd_build
}

# Host-side uproot plots from a run's out.root. Accepts a run dir, a bare run
# id (looked up under runs/), or a direct path to a .root file. Ensures the
# venv lazily, then delegates the schema inspection + plotting to the Python
# helper (shared by every platform).
cmd_analyze() {
  local arg="${1:-}"
  [[ -n "${arg}" ]] || die "usage: solid-gemc-run analyze <run-dir|id|out.root> [max-plots]"
  local max_plots="${2:-12}"
  local root run_dir
  if   [[ -f "${arg}" ]];      then root="${arg}";               run_dir="$(dirname "${arg}")"
  elif [[ -d "${arg}" ]];      then root="${arg}/out.root";      run_dir="${arg}"
  elif [[ -d "runs/${arg}" ]]; then root="runs/${arg}/out.root"; run_dir="runs/${arg}"
  else die "no run found for '${arg}'; check 'ls runs/'"
  fi
  [[ -f "${root}" ]] \
    || die "no ROOT file at ${root} (did the run succeed? see ${run_dir}/log.txt)"

  local py; py="$(ensure_venv_python)"
  "${py}" "${PLUGIN_ROOT}/bin/solid-gemc-analyze.py" "${root}" "${run_dir}" "${max_plots}"
  ls -1 "${run_dir}"/*.png 2>/dev/null || true
}

# Print resolved paths so a platform-neutral skill can locate the plugin's
# templates/reference dirs and the cache/venv without knowing the host's
# env-var conventions.
cmd_paths() {
  resolve_cache_dir; resolve_data_dir
  echo "root:       ${PLUGIN_ROOT}"
  echo "cache:      ${CACHE_DIR}"
  echo "data:       ${DATA_DIR}"
  echo "venv:       ${VENV_DIR}"
  echo "templates:  ${PLUGIN_ROOT}/templates"
  echo "reference:  ${PLUGIN_ROOT}/reference"
}

usage() {
  cat <<EOF
solid-gemc-run — apptainer wrapper for solid-gemc-claude

Usage: solid-gemc-run <subcommand> [args]

Subcommands:
  init [--force]                Bootstrap workspace: scaffold files + pull + clone + build.
  analyze <run|id|root> [N]     Host-side uproot plots from a run's out.root (max N plots).
  setup-python                  Idempotently install the analysis venv (uproot/numpy/...).
  pull                          Download the pinned .sif from upstream (wget).
  clone [dest]                  git clone solid_gemc into dest (default: ./solid_gemc).
  build [dest]                  Two scons builds inside container: mod/gemc/<v>, then source/<v>.
  env                           Print the tcsh env block (setenv SoLID_GEMC, GEMC, PATH, ...).
  info                          Show .sif URL, cache path, solid_gemc repo, GEMC_VERSION, apptainer.
  paths                         Print resolved root/cache/data/venv/templates/reference paths.
  shell                         Open an interactive tcsh inside the container with env set.
  exec <cmd...>                 Run a command inside the container with env set.
  root <args...>                Run ROOT (-l -b -q) inside the container with env set.
  validate-gcard <file>         xmllint a GCard file inside the container.

Container: ${SIF_URL}
solid_gemc: ${SOLID_GEMC_REPO} (HEAD of master)
GEMC_VERSION: ${GEMC_VERSION}

Cache resolution order:
  1. \$SOLID_GEMC_CLAUDE_CACHE                          (explicit override; any platform)
  2. \$CLAUDE_PLUGIN_DATA/cache                          (auto-set under Claude Code)
  3. \${XDG_CACHE_HOME:-~/.cache}/solid-gemc-claude      (off-Claude: Codex, standalone)
Run \`solid-gemc-run info\` to see the resolved cache path.
EOF
}

# --- dispatch ----------------------------------------------------------------
sub="${1:-}"; shift || true
case "${sub}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac
case "${sub}" in
  init)            cmd_init "$@" ;;
  analyze)         cmd_analyze "$@" ;;
  setup-python)    cmd_setup_python "$@" ;;
  paths)           cmd_paths "$@" ;;
  pull)            cmd_pull "$@" ;;
  clone)           cmd_clone "$@" ;;
  build)           cmd_build "$@" ;;
  env)             cmd_env "$@" ;;
  info)            cmd_info "$@" ;;
  shell)           cmd_shell "$@" ;;
  exec)            cmd_exec "$@" ;;
  root)            cmd_root "$@" ;;
  validate-gcard)  cmd_validate_gcard "$@" ;;
  *)               usage; die "unknown subcommand: ${sub}" ;;
esac
