#!/usr/bin/env bash
# solid-gemc-run — the only bridge between solid-gemc-claude and the SoLID/GEMC
# runtime. Every solid_gemc, scons, ROOT, or xmllint invocation in commands
# and skills must pass through here. The container .sif URL, solid_gemc
# upstream, and GEMC_VERSION are pinned in this file alone.

set -euo pipefail

# --- pinned runtime (single source of truth) ---------------------------------

# JLabCE 2.5 container. Hosted at Zhiwen Zhao's Duke physics webhome at v0.0.1
# (see README "Known limitations" — personal hosting, no SLA, mirror locally
# if you need durability). The sha256 in the filename is the docker image
# manifest digest of jeffersonlab/jlabce:2.5; that is *not* the .sif file's
# own content hash, so no automated checksum verification at v0.0.1.
SIF_NAME="jeffersonlab_jlabce_tag2.5_digest:sha256:9b9a9ec8c793035d5bfe6651150b54ac298f5ad17dca490a8039c530d0302008_20220413_s3.9.5.sif"
SIF_URL="http://webhome.phy.duke.edu/~zz81/simg/${SIF_NAME}"

# solid_gemc source. v0.0.1 clones HEAD of master (no upstream pin); the
# resolved commit SHA is recorded per run in runs/<id>/config.json.
SOLID_GEMC_REPO="https://github.com/JeffersonLab/solid_gemc"

# Version directory used inside solid_gemc's layout: mod/gemc/<v>, source/<v>.
# Bump only when solid_gemc upstream supports a new GEMC version line.
GEMC_VERSION="2.9"

# --- paths -------------------------------------------------------------------
PLUGIN_ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# --- helpers -----------------------------------------------------------------
log()  { printf '[solid-gemc-run] %s\n' "$*" >&2; }
die()  { printf '[solid-gemc-run] error: %s\n' "$*" >&2; exit 1; }

# Image cache: the .sif lives only in the running agent tool's persistent
# per-plugin data dir, <tool-home>/plugins/data/<plugin>-<marketplace>/cache.
# Both tools key that dir on plugin+marketplace (not version), so the ~1.7 GB
# image (no-SLA host) survives plugin updates. The tool is detected from the env
# its shell tool injects — CLAUDECODE (Claude Code), CODEX_THREAD_ID/CODEX_CI
# (Codex). $CLAUDE_PLUGIN_DATA/$PLUGIN_DATA are deliberately NOT read: both
# tools set them only for hooks/MCP, and other plugins' hooks can leak their
# own value into the shared shell env. With no tool detected (plain terminal)
# or both (nested session), an image already present in either tool's data dir
# is used read-only — never downloaded. Resolution is lazy so `help` works
# without any env vars set.
PLUGIN_DATA_NAME="solid-gemc-claude-solid-gemc-claude"
CACHE_DIR=""
SIF_DIR=""
SIF_PATH=""
AGENT_TOOL=""
CAN_PULL=0
CACHE_ERROR=""

plugin_cache_dir() {
  case "$1" in
    claude) echo "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/plugins/data/${PLUGIN_DATA_NAME}/cache" ;;
    codex)  echo "${CODEX_HOME:-${HOME}/.codex}/plugins/data/${PLUGIN_DATA_NAME}/cache" ;;
  esac
}

# Set AGENT_TOOL/CAN_PULL/CACHE_DIR, or CACHE_ERROR and return 1. No writes, no
# exit, so info/paths can still report an unresolved cache.
try_resolve_cache_dir() {
  [[ -n "${CACHE_DIR}" ]] && return 0
  local claude=0 codex=0 t
  [[ -n "${CLAUDECODE:-}" ]] && claude=1
  [[ -n "${CODEX_THREAD_ID:-}" || -n "${CODEX_CI:-}" ]] && codex=1
  if (( claude != codex )); then
    AGENT_TOOL="$( (( claude )) && echo claude || echo codex )"; CAN_PULL=1
    CACHE_DIR="$(plugin_cache_dir "${AGENT_TOOL}")"
  else
    for t in claude codex; do
      if [[ -f "$(plugin_cache_dir "${t}")/sif/${SIF_NAME}" ]]; then
        AGENT_TOOL="${t}"; CACHE_DIR="$(plugin_cache_dir "${t}")"; break
      fi
    done
    if [[ -z "${CACHE_DIR}" ]]; then
      if (( claude )); then
        CACHE_ERROR="both Claude Code and Codex detected (nested session?) and no .sif in either plugin data dir"
      else
        CACHE_ERROR="no agent tool detected and no .sif in either plugin data dir — pull once from Claude Code or Codex"
      fi
      return 1
    fi
  fi
  SIF_DIR="${CACHE_DIR}/sif"
  SIF_PATH="${SIF_DIR}/${SIF_NAME}"
}

resolve_cache_dir() {
  try_resolve_cache_dir || die "${CACHE_ERROR}"
}

# Data dir (venv home) resolution: <workspace-root>/venv (no override tier).
# The venv installs lazily on first use (see ensure_venv_python) on every
# platform — no session hook. Run `setup-python` to pre-install it.
DATA_DIR=""
VENV_DIR=""
resolve_data_dir() {
  [[ -n "${DATA_DIR}" ]] && return 0
  DATA_DIR="$(workspace_root)"
  VENV_DIR="${DATA_DIR}/venv"
}

# Human-readable label for the tool resolve_cache_dir detected. Shared by
# `info` and `init` so both report it the same way.
cache_source_label() {
  local name; name="$([[ "${AGENT_TOOL}" == claude ]] && echo "Claude Code" || echo "Codex")"
  if (( CAN_PULL )); then
    echo "${name} plugin data"
  else
    echo "existing .sif in ${name} plugin data; no single agent tool detected, read-only"
  fi
}

# Workspace root resolution. `init` drops WORKSPACE_MARKER in the dir it runs
# in (the workspace root). Every later subcommand walks up from $PWD to find
# that marker, so the same solid_gemc tree resolves whether the wrapper is
# invoked from the workspace root or a deep project/run subdir. Without this a
# bare `exec`/`shell` from a subdir defaulted SoLID_GEMC to ${PWD}/solid_gemc
# and silently missed the build tree (it relied on the skill exporting the var).
WORKSPACE_MARKER=".solid-gemc-workspace"

# Echo the nearest ancestor dir (inclusive of $PWD) containing the marker, or
# nothing and return 1 if none is found. No filesystem writes.
find_workspace_root() {
  local d; d="$(pwd -P)"
  while [[ "${d}" != "/" ]]; do
    [[ -f "${d}/${WORKSPACE_MARKER}" ]] && { printf '%s' "${d}"; return 0; }
    d="$(dirname "${d}")"
  done
  [[ -f "/${WORKSPACE_MARKER}" ]] && { printf '/'; return 0; }
  return 1
}

# The workspace root that anchors the venv and solid_gemc tree: the
# marker dir if one is found up-tree, else $PWD. The $PWD fallback mirrors
# env_block's ${PWD}/solid_gemc default and keeps a bare clone working before
# its first `init` (which writes the marker).
workspace_root() {
  find_workspace_root || pwd -P
}

# Default $SoLID_GEMC to <workspace-root>/solid_gemc when the caller has not
# set it. An explicit caller-set value always wins (the skill's symlink/reuse
# path). With no marker found we leave it unset, so env_block's ${PWD}/solid_gemc
# fallback preserves the pre-marker behavior for a bare clone at its root.
resolve_solid_gemc() {
  [[ -n "${SoLID_GEMC:-}" ]] && return 0
  local root; root="$(find_workspace_root)" || return 0
  export SoLID_GEMC="${root}/solid_gemc"
}

require_apptainer() {
  command -v apptainer >/dev/null 2>&1 \
    || die "apptainer not found on PATH. Install apptainer first (https://apptainer.org)."
}

require_wget() {
  command -v wget >/dev/null 2>&1 || die "wget not found on PATH."
}

require_git() {
  command -v git >/dev/null 2>&1 || die "git not found on PATH."
}

ensure_sif() {
  resolve_cache_dir
  require_apptainer
  if [[ -f "${SIF_PATH}" ]]; then return 0; fi
  (( CAN_PULL )) || die "no single agent tool detected, so no download — pull once from Claude Code or Codex"
  mkdir -p "${SIF_DIR}"
  require_wget
  log "downloading ${SIF_URL}"
  log "  -> ${SIF_PATH}"
  log "  (~1.7 GB .sif; first pull can take several minutes)"
  # Fixed .part path + -c so an interrupted pull resumes on re-run instead
  # of restarting from zero. The .sif host has no SLA (personal webhome),
  # so a dropped connection on the ~1.7 GB transfer is expected. The
  # partial is deliberately NOT deleted on failure — re-running `pull`
  # continues it.
  local tmp="${SIF_PATH}.part"
  if ! wget --show-progress -c -O "${tmp}" "${SIF_URL}"; then
    die "wget failed for ${SIF_URL} (partial kept at ${tmp}; re-run 'pull' to resume)"
  fi
  mv "${tmp}" "${SIF_PATH}"
  log "image ready at ${SIF_PATH}"
}

# Resolve symlinks before handing paths to apptainer. On shared-FS hosts the
# user's $HOME or $(pwd) can be a symlink chain (e.g. ~/work -> /work/...);
# apptainer will --bind the symlink path but then fail to chdir into it.
# `pwd -P` and `readlink -f` give the physical path apptainer can mount.
container_workdir()   { pwd -P; }
container_cache_dir() { readlink -f "${CACHE_DIR}"; }

# Tcsh env block for solid_gemc/GEMC inside the container. Honors any
# externally-set `$SoLID_GEMC` (lets the skill cd into a subdir like
# `solid_gemc/analysis/hgc_study/` to pick up cwd-relative detector loading
# while keeping `SoLID_GEMC` pinned to the workspace root). resolve_solid_gemc
# (run before every container invocation) exports it from the marker-located
# workspace root when unset; only a markerless bare clone falls through to the
# `${PWD}/solid_gemc` default here. The heredoc is single-quoted so `${VAR}`
# stays literal — tcsh interpolates at run time.
env_block() {
  cat <<'TCSH'
if ( ! $?SoLID_GEMC ) setenv SoLID_GEMC ${PWD}/solid_gemc
if ( ! $?LD_LIBRARY_PATH ) setenv LD_LIBRARY_PATH ""
setenv GEMC_VERSION 2.9
setenv GEMC ${SoLID_GEMC}/mod/gemc/${GEMC_VERSION}
setenv LD_LIBRARY_PATH ${GEMC}:${LD_LIBRARY_PATH}
setenv PATH ${SoLID_GEMC}/source/${GEMC_VERSION}:${GEMC}:${PATH}
TCSH
}

path_is_under() {
  local p="$1" dir="$2"
  [[ "$p" == "$dir" || "$p" == "$dir"/* ]]
}

# Echo host paths needing an explicit --bind beyond the workspace and cache.
# A path is auto-covered only if it is the bound workdir/cache or strictly
# inside one — an exact-prefix test, not a glob, so /work/ab does not swallow
# /work/abc. That distinction is load-bearing now that this feeds the core
# run path (the workspace root is a real bind, not a no-op).
extra_binds_for() {
  local wd="$1" cache_real="$2"; shift 2
  local p
  for p in "$@"; do
    [[ -z "$p" ]] && continue
    if ! path_is_under "$p" "$wd" && ! path_is_under "$p" "$cache_real"; then
      printf -- '--bind\n%s\n' "$p"
    fi
  done
}

# The bind set for any container invocation: cwd, cache, and — when
# $SoLID_GEMC is set — both the resolved solid_gemc tree and its parent
# (the workspace root). The skill/smoke cd into a deep subdir
# (solid_gemc/script, …) for cwd-relative geometry lookup, then read/write
# absolute paths in solid_gemc/{source,mod}/ (binary + libgemc.so) and
# <project>/runs/<id>/ (GCard in, EVIO/ROOT out) — none under cwd. Binding
# only cwd+cache made the run path work solely by accident of apptainer's
# implicit $HOME/$TMPDIR mount covering the workspace, which breaks on hosts
# with `mount home = no` or a workspace on /scratch|/work (violates
# non-negotiable #4). Both binds are needed, not redundant: when solid_gemc
# is a symlink out of the workspace (SGC_REUSE_SOLID_GEMC, or a user-linked
# prebuilt tree) the build tree lives under the resolved target while the
# run dir is a sibling of the symlink — the parent of the *unresolved* path.
# extra_binds_for dedupes whatever is already under cwd/cache.
# EXTRA_BIND_PATHS: per-command additions (analyze: the plugin's macro dir and
# a run dir outside cwd).
EXTRA_BIND_PATHS=()
container_binds() {
  local wd="$1" cache_real="$2"
  printf -- '--bind\n%s\n--bind\n%s\n' "${wd}" "${cache_real}"
  extra_binds_for "${wd}" "${cache_real}" ${EXTRA_BIND_PATHS[@]+"${EXTRA_BIND_PATHS[@]}"}
  [[ -n "${SoLID_GEMC:-}" && -d "${SoLID_GEMC}" ]] || return 0
  local solid_real parent_real
  solid_real="$(readlink -f "${SoLID_GEMC}")"
  parent_real="$(readlink -f "$(dirname "${SoLID_GEMC}")")"
  extra_binds_for "${wd}" "${cache_real}" "${solid_real}" "${parent_real}"
}

# Run a tcsh command inside the container with the env block applied and the
# current working directory plus the cache bind-mounted.
in_container() {
  local cmd="$1"
  local wd cache_real env
  resolve_solid_gemc
  wd="$(container_workdir)"
  # SOLID_GEMC_RUN_DRYRUN=1: print the resolved apptainer bind/pwd argv and
  # return without touching the .sif. A container-free seam for the bind
  # regression test in tests/quick-test.sh — short-circuits before
  # ensure_sif so it needs neither the 1.7 GB image nor a network pull.
  if [[ -n "${SOLID_GEMC_RUN_DRYRUN:-}" ]]; then
    resolve_cache_dir
    cache_real="$(container_cache_dir)"
    container_binds "${wd}" "${cache_real}"
    printf -- '--pwd\n%s\n' "${wd}"
    return 0
  fi
  ensure_sif
  cache_real="$(container_cache_dir)"
  env="$(env_block)"
  local -a binds=()
  while IFS= read -r line; do binds+=("${line}"); done < <(
    container_binds "${wd}" "${cache_real}")
  apptainer exec \
    "${binds[@]}" \
    --pwd "${wd}" \
    "${SIF_PATH}" \
    tcsh -c "${env}
${cmd}"
}

# --- python venv -------------------------------------------------------------

# Idempotently install requirements.txt into the resolved venv. Diffs the
# bundled requirements against a stored copy; no-op when in sync. Uses `uv`
# when available (fast), else python3 -m venv + pip. Invoked lazily by
# ensure_venv_python, or run by hand to pre-install. KEEP PY_MIN in sync with
# the "Python 3.9+" line in README/docs.
PY_MIN=3.9
cmd_setup_python() {
  resolve_data_dir
  local req="${PLUGIN_ROOT}/requirements.txt"
  # Sync marker lives inside the venv (not DATA_DIR, which is now the workspace
  # root — a bare requirements.txt there would look like the user's own deps).
  local stored="${VENV_DIR}/requirements.snapshot"
  [[ -f "${req}" ]] || die "requirements.txt not found at ${req}"
  # Skip the rebuild only when the venv actually works AND requirements are
  # unchanged. Gating on the interpreter (not just the snapshot) keeps this
  # self-healing if the venv was partially deleted or its python moved — a
  # stale snapshot alone must never short-circuit the build.
  [[ -x "${VENV_DIR}/bin/python" ]] \
    && diff -q "${req}" "${stored}" >/dev/null 2>&1 && return 0

  mkdir -p "${DATA_DIR}"
  log "installing Python deps into ${VENV_DIR} (one-time, ~30s)..."
  if [[ ! -x "${VENV_DIR}/bin/python" ]]; then
    rm -rf "${VENV_DIR}"
    if command -v uv >/dev/null 2>&1; then
      uv venv "${VENV_DIR}" --python ">=${PY_MIN}" >/dev/null
    else
      if ! python3 - "${PY_MIN}" <<'PY'
import sys
need = tuple(int(x) for x in sys.argv[1].split('.'))
raise SystemExit(0 if sys.version_info[:2] >= need else 1)
PY
      then
        die "python3 is $(python3 -V 2>&1 | awk '{print $2}'); need >= ${PY_MIN} (see README Requirements). Install a newer python3, or install 'uv'."
      fi
      python3 -m venv "${VENV_DIR}"
    fi
  fi

  local py="${VENV_DIR}/bin/python"
  if command -v uv >/dev/null 2>&1; then
    uv pip install --python "${py}" -r "${req}" >/dev/null
  else
    "${py}" -m pip install --upgrade pip >/dev/null
    "${py}" -m pip install -r "${req}" >/dev/null
  fi
  cp "${req}" "${stored}"   # mark success only after install succeeds
  log "Python deps ready."
}

# Echo the venv python, installing the venv first if absent. This is the only
# venv-install trigger (no session hook), so `analyze` always self-heals.
ensure_venv_python() {
  resolve_data_dir
  [[ -x "${VENV_DIR}/bin/python" ]] || cmd_setup_python >&2
  printf '%s' "${VENV_DIR}/bin/python"
}

# --- subcommands -------------------------------------------------------------

cmd_info() {
  echo "sif url:        ${SIF_URL}"
  if try_resolve_cache_dir; then
    echo "sif file:       ${SIF_PATH} $([[ -f ${SIF_PATH} ]] && echo '[present]' || echo '[not pulled]')"
    echo "cache:          ${CACHE_DIR}  [$(cache_source_label)]"
  else
    echo "cache:          (unresolved: ${CACHE_ERROR})"
  fi
  echo "plugin:         ${PLUGIN_ROOT}"
  echo "solid_gemc:     ${SOLID_GEMC_REPO} (HEAD of master)"
  echo "GEMC_VERSION:   ${GEMC_VERSION}"
  if command -v apptainer >/dev/null 2>&1; then
    echo "apptainer:      $(apptainer --version)"
  else
    echo "apptainer:      NOT FOUND"
  fi
}

cmd_pull() {
  ensure_sif
}

cmd_clone() {
  local dest="${1:-solid_gemc}"
  if [[ -d "${dest}/.git" ]]; then
    local existing_sha dirty=""
    existing_sha=$(cd "${dest}" && git rev-parse HEAD 2>/dev/null || echo unknown)
    if ! (cd "${dest}" && git diff --quiet HEAD 2>/dev/null); then
      dirty=" (uncommitted local changes)"
    fi
    log "warning: ${dest} already cloned at ${existing_sha}${dirty}"
    log "  using existing tree. To update it: git -C ${dest} pull, then solid-gemc-run build"
    return 0
  fi
  if [[ -e "${dest}" ]]; then
    die "${dest} exists but is not a git clone. Move it aside or remove first."
  fi
  require_git
  log "cloning ${SOLID_GEMC_REPO} -> ${dest}"
  git clone "${SOLID_GEMC_REPO}" "${dest}"
  log "cloned: $(cd "${dest}" && git rev-parse HEAD)"
  # Upstream takes changes only as fork -> pull request (its README).
  log "note: this clone of JeffersonLab/solid_gemc is for reading and running. To submit"
  log "  changes, fork it on GitHub, then: git -C ${dest} remote rename origin upstream &&"
  log "  git -C ${dest} remote add origin https://github.com/<you>/solid_gemc.git"
}

cmd_build() {
  local dest="${1:-solid_gemc}"
  [[ -d "${dest}" ]] \
    || die "solid_gemc tree not found at ${dest}; run 'solid-gemc-run clone' first"
  local gemc_dir="${dest}/mod/gemc/${GEMC_VERSION}"
  local solid_dir="${dest}/source/${GEMC_VERSION}"
  [[ -d "${gemc_dir}"  ]] \
    || die "missing ${gemc_dir} — solid_gemc layout may have changed; bump GEMC_VERSION in bin/solid-gemc-run?"
  [[ -d "${solid_dir}" ]] \
    || die "missing ${solid_dir} — solid_gemc layout may have changed?"
  # source/<v> finds the GEMC headers/library via $GEMC, which env_block derives
  # from SoLID_GEMC — so it must name the tree being built, not ./solid_gemc.
  SoLID_GEMC="$(cd "${dest}" && pwd)"; export SoLID_GEMC

  # LIBRARY=shared is REQUIRED — mod/gemc/2.9/SConstruct gates libgemc.so
  # behind it. Without LIBRARY=shared, scons builds only the per-module
  # .a static archives and never produces libgemc.so; the downstream
  # source/2.9 link then fails with `cannot find -lgemc`. source/2.9
  # doesn't need its own LIBRARY flag (the gate there is commented out).
  log "build 1/2: GEMC library at ${gemc_dir}"
  in_container "cd ${gemc_dir} && scons OPT=1 LIBRARY=shared -j4"
  log "build 2/2: solid_gemc at ${solid_dir}"
  in_container "cd ${solid_dir} && scons OPT=1 -j4"
  log "build complete: ${solid_dir}/solid_gemc"
}

cmd_env() {
  env_block
}

cmd_exec() {
  [[ $# -ge 1 ]] || die "usage: solid-gemc-run exec <command...>"
  in_container "$*"
}

cmd_shell() {
  ensure_sif
  resolve_solid_gemc
  local wd cache_real env
  wd="$(container_workdir)"
  cache_real="$(container_cache_dir)"
  env="$(env_block)"
  local -a binds=()
  while IFS= read -r line; do binds+=("${line}"); done < <(
    container_binds "${wd}" "${cache_real}")
  log "entering container ($(basename "${SIF_PATH}")). Type 'exit' to leave."
  apptainer exec \
    "${binds[@]}" \
    --pwd "${wd}" \
    "${SIF_PATH}" \
    tcsh -c "${env}
exec tcsh -i"
}

# $ROOTSYS/bin/root, not `root`: the image aliases root to `root -l --web=off`,
# which this ROOT build rejects with spurious errors on every call.
cmd_root() {
  in_container "\$ROOTSYS/bin/root -l -b -q $*"
}

cmd_validate_gcard() {
  local gcard="${1:-}"
  [[ -n "${gcard}" ]] || die "usage: solid-gemc-run validate-gcard <file.gcard>"
  [[ -f "${gcard}"  ]] || die "GCard not found: ${gcard}"
  in_container "xmllint --noout '${gcard}'"
  log "GCard well-formed: ${gcard}"
}

# One-shot workspace bootstrap: scaffold the workspace-common files, pull the
# .sif, clone solid_gemc, build it. Non-interactive — the collision/overwrite
# prompt lives in the adapter layer (Claude command / skill). Per-file
# skip-unless-force keeps it idempotent; solid_gemc/ and project subdirs are
# never touched.
cmd_init() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1
  require_apptainer; require_git; require_wget

  # Mark this dir as the workspace root FIRST — the venv/solid_gemc resolution
  # anchors on it (workspace_root), so the marker must exist before
  # resolve_data_dir runs below or the venv would resolve to a stale $PWD
  # fallback. Always (re)written — it carries no state, just marks the root.
  printf 'solid-gemc-claude workspace root\n' > "./${WORKSPACE_MARKER}"

  # Report where everything will resolve before doing any work.
  resolve_cache_dir; resolve_data_dir
  log "workspace:     $(workspace_root)"
  log "plugin root:   ${PLUGIN_ROOT}"
  log "cache:         ${CACHE_DIR}  [$(cache_source_label)]"
  log "sif:           ${SIF_PATH}"
  log "venv:          ${VENV_DIR}"

  local tdir="${PLUGIN_ROOT}/templates" f src dst
  for f in CLAUDE.md AGENTS.md README.md .gitignore log.md result.md report.html; do
    src="${tdir}/${f}"; dst="./${f}"
    # CLAUDE.md is a symlink to AGENTS.md in the repo; `codex plugin add` drops
    # symlinks, so write it from the real AGENTS.md on every platform.
    [[ "${f}" == CLAUDE.md ]] && src="${tdir}/AGENTS.md"
    [[ -e "${src}" ]] || continue
    if [[ -e "${dst}" && ${force} -eq 0 ]]; then
      log "exists, skipping (use --force to overwrite): ${dst}"
      continue
    fi
    cp -L "${src}" "${dst}"
    log "wrote ${dst}"
  done

  # Workspace launcher: makes `bin/solid-gemc-run` real in the workspace (the
  # wrapper itself lives in the version-pinned plugin install). Always
  # (re)written — generated, no user state. Fallback = this wrapper. Never when
  # ./bin/solid-gemc-run IS this wrapper (init run inside the plugin repo or a
  # clone): overwriting it would leave a launcher whose fallback is itself.
  if [[ ./bin/solid-gemc-run -ef "${PLUGIN_ROOT}/bin/solid-gemc-run" ]]; then
    log "skipping workspace launcher: ./bin/solid-gemc-run is the plugin wrapper itself"
  else
    local launcher
    launcher="$(<"${tdir}/workspace-launcher.sh")"
    mkdir -p ./bin
    printf '%s\n' "${launcher//@SGC_INIT_WRAPPER@/"${PLUGIN_ROOT}/bin/solid-gemc-run"}" > ./bin/solid-gemc-run
    chmod +x ./bin/solid-gemc-run
    log "wrote ./bin/solid-gemc-run (workspace launcher)"
  fi

  # Numbered steps with elapsed time: init can run 5–15 min (mostly the two
  # builds), and agents relay these lines so the user can see it is moving.
  local t0=${SECONDS}
  log "step 1/4: container image$([[ -f ${SIF_PATH} ]] && echo ' (already downloaded)' || echo ' (downloading ~1.7 GB)')"
  cmd_pull
  log "step 2/4: solid_gemc clone ($((SECONDS - t0)) s so far)"
  cmd_clone
  log "step 3/4: build — two scons passes, usually 5–15 min ($((SECONDS - t0)) s so far)"
  # SOLID_GEMC_SKIP_BUILD=1: test seam (tests/quick-test.sh, tests/basic-test.sh) —
  # those test the plugin, not solid_gemc, and link an already-built tree, so the
  # two scons passes are skipped; the binary must exist and the smoke below still runs.
  if [[ -n "${SOLID_GEMC_SKIP_BUILD:-}" ]]; then
    [[ -x "solid_gemc/source/${GEMC_VERSION}/solid_gemc" ]] \
      || die "SOLID_GEMC_SKIP_BUILD is set but solid_gemc/source/${GEMC_VERSION}/solid_gemc is not built"
    log "skipping the scons build (SOLID_GEMC_SKIP_BUILD): using the prebuilt tree"
  else
    cmd_build
  fi

  # Post-build smoke: confirm the freshly built binary actually resolves on the
  # in-container PATH. Catches a broken build or a broken env block immediately,
  # while the user is watching init, instead of at the first real run.
  log "step 4/4: check that solid_gemc runs in the container ($((SECONDS - t0)) s so far)"
  local smoke
  if smoke="$(in_container "which solid_gemc" 2>&1)"; then
    log "init done in $((SECONDS - t0)) s: solid_gemc on PATH in-container"
  elif grep -qiE "operation not permitted|FATAL" <<<"${smoke}"; then
    printf '%s\n' "${smoke}" | tail -5 >&2
    [[ -n "${CODEX_THREAD_ID:-}${CODEX_CI:-}" ]] \
      && die "apptainer could not start the container — Codex's sandbox blocks it. Approve running solid-gemc-run outside the sandbox, or set /permissions to 'Ask for approval' so Codex can ask."
    die "apptainer could not start the container (see the error above)"
  else
    printf '%s\n' "${smoke}" | tail -5 >&2
    die "post-build smoke failed: 'solid_gemc' not found on PATH inside the container (build or env block is broken)"
  fi
}

# Default plots from a run's out.root. Accepts a run dir, a bare run id (looked
# up under runs/), or a direct path to a .root file. Default: ROOT inside the
# container (SVG per branch + plots.pdf; the image's ROOT has no PNG writer).
# --python: host-side uproot PNGs, installing the venv lazily.
cmd_analyze() {
  local python=0
  [[ "${1:-}" == "--python" ]] && { python=1; shift; }
  local arg="${1:-}"
  [[ -n "${arg}" ]] || die "usage: solid-gemc-run analyze [--python] <run-dir|id|out.root> [max-plots]"
  local max_plots="${2:-12}"
  local root run_dir
  if   [[ -f "${arg}" ]];      then root="${arg}";               run_dir="$(dirname "${arg}")"
  elif [[ -d "${arg}" ]];      then root="${arg}/out.root";      run_dir="${arg}"
  elif [[ -d "runs/${arg}" ]]; then root="runs/${arg}/out.root"; run_dir="runs/${arg}"
  else die "no run found for '${arg}'; check 'ls runs/'"
  fi
  [[ -f "${root}" ]] \
    || die "no ROOT file at ${root} (did the run succeed? see ${run_dir}/log.txt)"

  if (( python )); then
    local py; py="$(ensure_venv_python)"
    "${py}" "${PLUGIN_ROOT}/bin/solid-gemc-analyze.py" "${root}" "${run_dir}" "${max_plots}"
    ls -1 "${run_dir}"/*.png 2>/dev/null || true
    return 0
  fi
  [[ "${max_plots}" =~ ^[0-9]+$ ]] || die "max-plots must be a number: ${max_plots}"
  root="$(readlink -f "${root}")"; run_dir="$(readlink -f "${run_dir}")"
  EXTRA_BIND_PATHS=("${PLUGIN_ROOT}/bin" "${run_dir}")
  cmd_root "'${PLUGIN_ROOT}/bin/solid_gemc_analyze.C(\"${root}\",\"${run_dir}\",${max_plots})'"
  ls -1 "${run_dir}"/*.svg "${run_dir}"/plots.pdf 2>/dev/null || true
}

# Copy a GCard into a project and set the batch options inside its live
# <gcard> block: OUTPUT=evio,out.evio, N, USE_GUI=0 and RECORD_OPTICALPHOTONS=1
# (off with --no-optical). <gcard> is a path, or a name looked up under
# solid_gemc/script/ then solid_gemc/analysis/*/. Host-only (no container).
# Prints the project copy and the source dir that `run` must start gemc from.
cmd_gcard() {
  local name="" project="" n=100 optical=1 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --events)     n="${2:-}"; shift 2 || die "--events needs a number" ;;
      --no-optical) optical=0; shift ;;
      --force)      force=1; shift ;;
      -*)           die "unknown option: $1" ;;
      *) if [[ -z "${name}" ]]; then name="$1"; elif [[ -z "${project}" ]]; then project="$1"
         else die "too many arguments: $1"; fi; shift ;;
    esac
  done
  [[ -n "${name}" && -n "${project}" ]] \
    || die "usage: solid-gemc-run gcard <gcard|name> <project> [--events N] [--no-optical] [--force]"
  [[ "${n}" =~ ^[0-9]+(e[0-9]+)?$ ]] || die "--events must be a number like 100 or 1e4: ${n}"
  [[ -d "${project}" ]] || die "project dir not found: ${project}"

  local src="" sg c
  if [[ -f "${name}" ]]; then
    src="${name}"
  else
    sg="$(find_workspace_root || pwd)/solid_gemc"
    local -a hits=()
    for c in "${sg}/script/${name}" "${sg}/script/${name}.gcard" "${sg}/script/solid_${name}.gcard" \
             "${sg}"/analysis/*/"${name}" "${sg}"/analysis/*/"${name}.gcard"; do
      [[ -f "${c}" ]] && hits+=("${c}")
    done
    (( ${#hits[@]} > 0 )) || die "no GCard '${name}' under ${sg}/script/ or ${sg}/analysis/*/"
    (( ${#hits[@]} == 1 )) || die "'${name}' matches several GCards; pass a path: ${hits[*]}"
    src="${hits[0]}"
  fi
  local dest="${project%/}/$(basename "${src}")"
  [[ ! -e "${dest}" || ${force} -eq 1 ]] \
    || die "${dest} exists (it may hold your edits); use --force to replace it"
  cp "${src}" "${dest}"
  python3 - "${dest}" "${n}" "${optical}" <<'PY'
import re, sys, pathlib
path, n_events, optical = sys.argv[1:4]
text = pathlib.Path(path).read_text()
m = re.search(r'(<gcard>)(.*?)(</gcard>)', text, re.DOTALL)
if not m:
    sys.exit(f"no <gcard>...</gcard> block in {path}")
# Only the live block; canonicals carry commented examples after it. [^>]* also
# matches the `name="USE_GUI"  value=` double-space variant.
body = re.sub(r'^[ \t]*<option name="(OUTPUT|N|USE_GUI|RECORD_OPTICALPHOTONS)"[^>]*/>[ \t]*\n',
              '', m.group(2), flags=re.MULTILINE)
adds = ['<option name="OUTPUT" value="evio,out.evio"/>',
        f'<option name="N" value="{n_events}"/>',
        '<option name="USE_GUI" value="0"/>']
if optical == '1':
    adds.append('<option name="RECORD_OPTICALPHOTONS" value="1"/>')
pathlib.Path(path).write_text(text[:m.start(2)] + body.rstrip() + '\n' + '\n'.join(adds) + '\n' + text[m.end(2):])
PY
  log "N=${n}, optical photons $( (( optical )) && echo on || echo off), USE_GUI=0, OUTPUT=evio"
  echo "gcard: ${dest}"
  echo "source dir: $(cd "$(dirname "${src}")" && pwd)"
}

# One simulation run, end to end, as one command (one step for an agent to run
# and a user to approve): check the GCard, freeze it into <project>/runs/<id>/,
# run gemc from <source-dir> (gemc resolves <detector name> from its cwd),
# convert with evio2root -R=flux -B=<the GCard's detector banks> (without -B the
# detector trees come out empty), write config.json, then analyze.
cmd_run() {
  local gcard="${1:-}" src="${2:-}" max_plots="${3:-12}"
  [[ -f "${gcard}" && -d "${src}" ]] \
    || die "usage: solid-gemc-run run <project>/<preset>.gcard <source-dir> [max-plots]"
  resolve_solid_gemc
  if [[ -z "${SoLID_GEMC:-}" ]]; then
    [[ -d solid_gemc ]] || die "no solid_gemc/ here; run from the workspace root (see 'init')"
    export SoLID_GEMC="$(pwd)/solid_gemc"
  fi
  # Logical (not -P) paths: provenance names the workspace's solid_gemc/ even
  # when it is a symlink.
  gcard="$(cd "$(dirname "${gcard}")" && pwd)/$(basename "${gcard}")"
  src="$(cd "${src}" && pwd)"
  cmd_validate_gcard "${gcard}"

  local id run_dir log start t0 gemc_exit=0 e2r_exit=- banks=""
  id="$(date -u +%Y%m%d-%H%M%S)-$(printf '%06x' $(( (RANDOM << 15 | RANDOM) & 0xffffff )))"
  run_dir="$(dirname "${gcard}")/runs/${id}"; log="${run_dir}/log.txt"
  mkdir -p "${run_dir}"
  cp "${gcard}" "${run_dir}/gcard.gcard"
  EXTRA_BIND_PATHS=("${run_dir}")
  start="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; t0=${SECONDS}

  log "run ${id}: gemc from ${src}"
  ( cd "${src}" && in_container \
      "solid_gemc '${run_dir}/gcard.gcard' -OUTPUT='evio,${run_dir}/out.evio'" ) \
    > "${log}" 2>&1 || gemc_exit=$?
  tail -n 5 "${log}" >&2
  if (( gemc_exit == 0 )) && [[ -s "${run_dir}/out.evio" ]]; then
    banks="$(python3 - "${run_dir}/gcard.gcard" "${src}" <<'PY'
import os, re, sys, pathlib
text = re.sub(r'<!--.*?-->', '', pathlib.Path(sys.argv[1]).read_text(), flags=re.DOTALL)
banks = []
for name in re.findall(r'<detector\s+name="([^"]+)"', text):
    p = os.path.abspath(os.path.join(sys.argv[2], name))
    if pathlib.Path(p + "__bank.txt").is_file() and p not in banks:
        banks.append(p)
print(" ".join(banks))
PY
)"
    log "evio2root -R=flux${banks:+ -B=${banks}}"
    e2r_exit=0
    ( cd "${run_dir}" && in_container \
        "evio2root -INPUTF=out.evio -R=flux${banks:+ -B='${banks}'}" ) \
      >> "${log}" 2>&1 || e2r_exit=$?
    tail -n 3 "${log}" >&2
  fi

  local sha repo n
  sha="$(git -C "${SoLID_GEMC}" rev-parse HEAD 2>/dev/null || echo unknown)"
  repo="$(git -C "${SoLID_GEMC}" remote get-url origin 2>/dev/null | sed -E 's#://[^/@]+@#://#' || true)"
  n="$(grep -oE '<option name="N" value="[^"]+"' "${run_dir}/gcard.gcard" | head -1 | sed 's/.*value="//; s/"$//' || true)"
  python3 - "${run_dir}/config.json" "${id}" "$(basename "$(dirname "${gcard}")")" "${gcard}" \
      "${run_dir}" "${src}" "${n}" "${SIF_NAME}" "${repo:-unknown}" "${sha}" "${GEMC_VERSION}" \
      "${SoLID_GEMC}" "${start}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$((SECONDS - t0))" \
      "${gemc_exit}" "${e2r_exit}" "${banks}" <<'PY'
import json, sys, pathlib
(out, rid, project, gsrc, rdir, src, n, sif, repo, sha, gv, sg,
 start, end, wall, gx, ex, banks) = sys.argv[1:]
num = lambda v: None if v == "-" else int(v)
gx, ex = int(gx), num(ex)
d = {
  "run_id": rid, "project": project,
  "gcard_source": gsrc, "gcard_frozen": f"{rdir}/gcard.gcard",
  "source_dir": src, "n_events": n, "sif_name": sif,
  "solid_gemc": sg, "solid_gemc_repo": repo, "solid_gemc_sha": sha, "gemc_version": gv,
  "start_utc": start, "end_utc": end, "wall_seconds": int(wall),
  "gemc_exit_code": gx, "evio2root_exit": ex,
  "exit_code": gx if gx else (ex if ex is not None else 1),
  "evio2root_banks": banks,
  "command": "solid_gemc <gcard_frozen> -OUTPUT=evio,<run>/out.evio  (cwd: source_dir); "
             "evio2root -INPUTF=out.evio -R=flux -B=<evio2root_banks>  (cwd: run dir)",
}
pathlib.Path(out).write_text(json.dumps(d, indent=2) + "\n")
PY
  (( gemc_exit == 0 )) || die "gemc failed (exit ${gemc_exit}); see ${log}. Run dir: ${run_dir}"
  # gemc exits 0 even when it can't load a detector ("Failed to open geometry
  # file … Exiting.") — usually a <detector name> not found from <source-dir>.
  [[ -s "${run_dir}/out.evio" ]] \
    || die "gemc wrote no out.evio (a detector not found from ${src}? see ${log}). Run dir: ${run_dir}"
  [[ "${e2r_exit}" == 0 ]] || die "evio2root failed (exit ${e2r_exit}); see ${log}. Run dir: ${run_dir}"
  log "run ${id}: gemc + evio2root ok ($((SECONDS - t0)) s); config.json written"
  cmd_analyze "${run_dir}" "${max_plots}"
  echo "run dir: ${run_dir}"
}

# Print resolved paths so a platform-neutral skill can locate the plugin's
# templates/reference dirs and the cache/venv without knowing the host's
# env-var conventions.
cmd_paths() {
  resolve_data_dir
  echo "root:       ${PLUGIN_ROOT}"
  if try_resolve_cache_dir; then
    echo "cache:      ${CACHE_DIR}"
  else
    echo "cache:      (unresolved: ${CACHE_ERROR})"
  fi
  echo "data:       ${DATA_DIR}"
  echo "venv:       ${VENV_DIR}"
  echo "templates:  ${PLUGIN_ROOT}/templates"
  echo "reference:  ${PLUGIN_ROOT}/reference"
}

usage() {
  cat <<EOF
solid-gemc-run — apptainer wrapper for solid-gemc-claude

Usage: solid-gemc-run <subcommand> [args]

Subcommands:
  init [--force]                Bootstrap workspace: scaffold files + pull + clone + build.
  gcard <gcard|name> <project> [--events N] [--no-optical] [--force]
                                Copy a GCard into <project>, set OUTPUT/N/USE_GUI=0 and
                                RECORD_OPTICALPHOTONS=1; prints the copy + its source dir.
  run <gcard> <source-dir> [N]  One run: check + freeze the GCard into <project>/runs/<id>/,
                                gemc from <source-dir>, evio2root -R=flux -B=<detector banks>,
                                config.json, then analyze (max N plots).
  analyze [--python] <run|id|root> [N]
                                Default plots from a run's out.root (max N): ROOT in the
                                container (SVG + plots.pdf); --python: host uproot PNGs.
  setup-python                  Install the venv for analyze --python (uproot/numpy/...).
  pull                          Download the pinned .sif from upstream (wget).
  clone [dest]                  git clone solid_gemc into dest (default: ./solid_gemc).
  build [dest]                  Two scons builds inside container: mod/gemc/<v>, then source/<v>.
  env                           Print the tcsh env block (setenv SoLID_GEMC, GEMC, PATH, ...).
  info                          Show .sif URL, cache path, solid_gemc repo, GEMC_VERSION, apptainer.
  paths                         Print resolved root/cache/data/venv/templates/reference paths.
  shell                         Open an interactive tcsh inside the container with env set.
  exec <cmd...>                 Run a command inside the container with env set.
  root <args...>                Run ROOT (-l -b -q) inside the container with env set.
  validate-gcard <file>         xmllint a GCard file inside the container.

Container: ${SIF_URL}
solid_gemc: ${SOLID_GEMC_REPO} (HEAD of master)
GEMC_VERSION: ${GEMC_VERSION}

Image cache (.sif) — the running agent tool's persistent plugin data dir:
  Claude Code (CLAUDECODE set):            \${CLAUDE_CONFIG_DIR:-~/.claude}/plugins/data/${PLUGIN_DATA_NAME}/cache
  Codex (CODEX_THREAD_ID or CODEX_CI set): \${CODEX_HOME:-~/.codex}/plugins/data/${PLUGIN_DATA_NAME}/cache
It survives plugin updates. With no single tool detected (plain terminal), an
.sif already in either dir is used read-only; nothing is downloaded. The venv
stays at <workspace-root>/venv. \`init\` also writes <workspace>/bin/solid-gemc-run,
a launcher that finds the newest installed wrapper on each call.
Run \`solid-gemc-run info\` / \`paths\` to see the resolved paths.
EOF
}

# --- dispatch ----------------------------------------------------------------
sub="${1:-}"; shift || true
case "${sub}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac
case "${sub}" in
  init)            cmd_init "$@" ;;
  gcard)           cmd_gcard "$@" ;;
  run)             cmd_run "$@" ;;
  analyze)         cmd_analyze "$@" ;;
  setup-python)    cmd_setup_python "$@" ;;
  paths)           cmd_paths "$@" ;;
  pull)            cmd_pull "$@" ;;
  clone)           cmd_clone "$@" ;;
  build)           cmd_build "$@" ;;
  env)             cmd_env "$@" ;;
  info)            cmd_info "$@" ;;
  shell)           cmd_shell "$@" ;;
  exec)            cmd_exec "$@" ;;
  root)            cmd_root "$@" ;;
  validate-gcard)  cmd_validate_gcard "$@" ;;
  *)               usage; die "unknown subcommand: ${sub}" ;;
esac
