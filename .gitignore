# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Python tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/

# Local/private overrides (not for the public repo)
.claude.local.md
.env
BUILD_LOG.md
PLAN.md
CODEX_PORT_PLAN.md

# Apptainer cache (normally outside the repo; defensive)
*.sif
*.sif.part

# Defensive: someone running the smoke test at the repo root.
# Leading `/` anchors to the repo root only — without it, the pattern
# also matches templates/workspace/runs/, dropping the shipped skeleton's
# runs/ placeholder from the package.
/runs/
/solid_gemc/

# Built solid_gemc clone used by tests/quick-test.sh (~1 GB). Don't install the
# plugin straight from this dir: a local marketplace install would copy it.
/templates/solid_gemc
# Persistent uv download cache for tests/quick-test.sh.
/.test-cache/

# Logs
*.log

# Per-user Claude Code local settings
.claude/settings.local.json
